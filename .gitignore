PROMOTION_PLAN.local.md
target/
dist/
node_modules/
pkg/
*.wasm
!src/**/*.wasm
.DS_Store
.worktrees/
.bench/
__pycache__/
# hugo-module/static/eddie/ is assembled by scripts/publish-hugo-module.sh
# from a fresh dist/ build; publish-hugo-module.yml always regenerates it in
# a clean checkout and rsyncs the result (with --delete) into the separate
# jt55401/eddie-hugo repo, so nothing committed here is ever actually
# consumed by the release pipeline. Previously only the plain .js/.wasm
# were ignored, which let precompressed .br/.gz siblings for gone asset
# names (eddie.wasm, eddie-wasm.js) linger as stale tracked files; ignore
# the whole directory instead.
hugo-module/static/eddie/

# Widget runtime assets (and the widget/assets.list manifest copy) are built
# by widget/build.sh and copied into each CMS package's assets/ dir by
# scripts/sync-integration-assets.sh (or the publish-{npm,pypi,rubygems}.yml
# workflows) at publish time -- see widget/assets.list for the current file
# list and docs/guides/package-publishing.md for how it's populated. Nothing
# under these directories should ever be committed, so they're ignored
# wholesale rather than by enumerated filename (which drifted out of sync
# with the actual asset list before).
integrations/*/npm/assets/
integrations/*/gem/assets/
integrations/mkdocs/pypi/src/eddie_mkdocs/assets/
.playwright-mcp/
