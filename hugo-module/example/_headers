# Cache-Control for the Eddie runtime on Cloudflare Pages or Netlify: copy
# this file to your site's static/ directory (it is served as /_headers).
#
# Every runtime asset the widget fetches carries ?v=<index hash> (the Hugo
# partial derives it from the index), so a new deploy uses new URLs and the
# files themselves can be cached for a year: eddie-lite.wasm, eddie-dense.wasm,
# eddie-worker.js, eddie-sw-*.js, index.ed and its index.<lane>.ed sidecars,
# models/<lane>/*. Both hosts match rules on the path only; the query string
# is part of the browser's and the CDN's cache key, which is what makes ?v=
# work with `immutable`.
#
# The two scripts the page references without ?v= (eddie-boot.js by default,
# eddie-widget.js with loader = "full") must keep revalidating, or a widget
# update would wait a year. Later rules override earlier ones for the same
# header on both hosts.

/eddie/*
  Cache-Control: public, max-age=31536000, immutable

/eddie/eddie-boot.js
  Cache-Control: public, max-age=300, must-revalidate

/eddie/eddie-widget.js
  Cache-Control: public, max-age=300, must-revalidate
